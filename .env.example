# Base PostgreSQL (voir docker-compose.yml)
DATABASE_URL=postgresql://gmao:gmao@localhost:5432/gmao

# Better Auth : secret de 32 caractères minimum (openssl rand -base64 32) et URL publique de l'application
BETTER_AUTH_SECRET=remplacer-par-un-secret-aleatoire-de-32-caracteres
BETTER_AUTH_URL=http://localhost:3000

# SSO Microsoft Entra ID (facultatif, INT-03) : laisser vide pour désactiver
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Documents joints (EQP-07) : taille maximale par fichier, en Mo
DOCUMENT_MAX_SIZE_MB=20

# Stockage des fichiers : local (répertoire du serveur) ou s3 (AWS, Scaleway, OVH, SeaweedFS…)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Avec STORAGE_DRIVER=s3 (valeurs du service « s3 » de docker-compose, profil s3) :
# S3_BUCKET=gmao-documents
# S3_ENDPOINT=http://localhost:8333
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=gmao
# S3_SECRET_ACCESS_KEY=gmao-dev-secret
# S3_AUTO_CREATE_BUCKET=true
# S3_SERVER_SIDE_ENCRYPTION=none

# Courriels (NOT-01) : SMTP si SMTP_HOST est renseigné, sinon journal du processus (aucun envoi réel)
# Développement : Mailpit de docker-compose (interface http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="GMAO <no-reply@gmao.local>"
# Adresse publique utilisée dans les liens des courriels (par défaut BETTER_AUTH_URL)
# APP_URL=https://gmao.example.fr
# Heure d'envoi des récapitulatifs quotidiens (fuseau Europe/Paris)
EMAIL_DIGEST_HOUR=7
# Processus d'envoi (npm run worker) : file toutes les N secondes, alertes calculées toutes les N minutes
# EMAIL_WORKER_INTERVAL_SECONDS=30
# EMAIL_ALERTS_INTERVAL_MINUTES=15
# Tâche planifiée externe (POST /api/cron/notifications, en-tête Authorization: Bearer) : 16 caractères au moins
# CRON_SECRET=
